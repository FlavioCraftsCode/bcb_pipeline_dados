# Copie para .env e ajuste. O .env não vai para o Git.
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=bcb_dw

# Usado pela pipeline e pela API quando rodam fora do Docker
DATABASE_URL=postgresql+psycopg2://admin:securepassword@localhost:5432/bcb_dw

# Banco descartável para os testes de integração (o teste recria o schema!)
DATABASE_URL_TESTE=postgresql+psycopg2://admin:securepassword@localhost:5432/bcb_test

LOG_LEVEL=INFO
